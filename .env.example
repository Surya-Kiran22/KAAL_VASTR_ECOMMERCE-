# ------------------------------------------------------------------
# Kaal Vastr — Environment Variables
# Copy this file to `.env` and fill in your own project values.
# NEVER commit the real `.env` file.
# ------------------------------------------------------------------

# Supabase connection (required for live backend)
# Create a project at https://supabase.com then copy these from
# Project Settings -> API.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabase projects created recently may publish a "publishable key"
# instead of a legacy anon key. Either variable is accepted:
# VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key